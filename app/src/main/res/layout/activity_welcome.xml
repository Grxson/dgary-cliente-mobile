<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Image - Ocupa toda la pantalla sin espacios en blanco -->
    <ImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:src="@drawable/bienvenida2" />


    <!-- Button Container - Superpuesto sobre la imagen -->

    <ImageView
        android:id="@+id/logo"
        android:layout_width="255dp"
        android:layout_height="75dp"
        android:layout_marginTop="@dimen/margin_xlarge"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_nombre_preview" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="@dimen/margin_large"
        android:paddingEnd="@dimen/margin_large"
        android:paddingBottom="@dimen/margin_xlarge">

        <!-- Sign In Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sign_in"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/welcome_sign_in"
            android:textSize="@dimen/button_text_size"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:backgroundTint="@color/dgary_yellow"
            app:cornerRadius="@dimen/corner_radius_medium"
            android:elevation="8dp" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/margin_large" />

        <!-- Sign Up Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sign_up"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/welcome_sign_up"
            android:textSize="@dimen/button_text_size"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:backgroundTint="@color/dgary_yellow"
            app:cornerRadius="@dimen/corner_radius_medium"
            android:elevation="8dp" />
    </LinearLayout>
</FrameLayout>

