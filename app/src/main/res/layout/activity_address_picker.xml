<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/white">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="@dimen/margin_large" android:background="@color/white">

        <ImageView android:id="@+id/btn_back_address_picker" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@string/back_button" android:scaleType="fitCenter" android:src="@drawable/ic_back" app:tint="@color/black" android:layout_marginEnd="@dimen/margin_medium" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/account_agregar_ubicacion" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/black" />
    </LinearLayout>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/text_secondary" />

    <!-- Map -->
    <fragment android:id="@+id/map_address_picker" android:name="com.google.android.gms.maps.SupportMapFragment" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <!-- Bottom Sheet with Form -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/margin_large" android:background="@color/white" android:elevation="8dp">

        <!-- Selected Address Display -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/account_ubicacion_seleccionada" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginBottom="@dimen/margin_small" />

        <TextView android:id="@+id/tv_selected_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/account_toca_mapa" android:textSize="14sp" android:textColor="@color/black" android:layout_marginBottom="@dimen/margin_large" android:minHeight="40dp" />

        <!-- Address Title Input -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/account_nombre_ubicacion" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginBottom="@dimen/margin_small" />

        <EditText android:id="@+id/et_address_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/account_ej_casa_trabajo" android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/text_secondary" android:padding="@dimen/margin_medium" android:background="@drawable/bg_input_search" android:layout_marginBottom="@dimen/margin_large" android:inputType="text" />

        <!-- Save Button -->
        <Button android:id="@+id/btn_save_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/account_guardar_ubicacion" android:textSize="14sp" android:textStyle="bold" android:padding="@dimen/margin_large" android:background="@drawable/bg_button_primary" android:textColor="@color/white" android:textAllCaps="false" android:elevation="2dp" />
    </LinearLayout>

</LinearLayout>
