<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/margin_medium" android:layout_marginBottom="@dimen/margin_medium" android:background="@drawable/bg_discount_badge">

    <TextView android:id="@+id/tv_order_summary_id" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/black" android:textSize="16sp" android:textStyle="bold" />

    <TextView android:id="@+id/tv_order_summary_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="@dimen/margin_small" />

    <TextView android:id="@+id/tv_order_summary_items" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="@dimen/margin_small" />

    <TextView android:id="@+id/tv_order_summary_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/dgary_green" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="@dimen/margin_small" />
</LinearLayout>