<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/margin_medium" android:layout_marginBottom="@dimen/margin_medium" android:background="@color/white">

    <!-- Title and Actions -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="@dimen/margin_small">

        <!-- Left Section with Icon and Title -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">

            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@string/account_lugares_guardados" android:scaleType="fitCenter" android:src="@drawable/ic_back" app:tint="@color/dgary_green" android:layout_marginEnd="@dimen/margin_small" />

            <TextView android:id="@+id/tv_address_titulo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/black" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">

            <ImageView android:id="@+id/btn_edit_address" android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@string/account_editar" android:scaleType="fitCenter" android:src="@drawable/ic_back" app:tint="@color/dgary_green" android:layout_marginEnd="@dimen/margin_small" />

            <ImageView android:id="@+id/btn_delete_address" android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@string/account_eliminar" android:scaleType="fitCenter" android:src="@drawable/ic_back" app:tint="@color/red" />
        </LinearLayout>
    </LinearLayout>

    <!-- Address -->
    <TextView android:id="@+id/tv_address_direccion" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginStart="32dp" android:layout_marginBottom="@dimen/margin_medium" />

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/text_secondary" />

</LinearLayout>

