<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/white" android:gravity="center_vertical" android:orientation="horizontal" android:padding="@dimen/margin_large">

        <ImageView android:id="@+id/btn_back_location" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@string/back_button" android:src="@drawable/ic_back" app:tint="@color/black" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/margin_medium" android:text="@string/location_confirm_title" android:textColor="@color/black" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>

    <fragment android:id="@+id/map_location_selection" android:name="com.google.android.gms.maps.SupportMapFragment" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/surface_soft" android:orientation="vertical" android:padding="@dimen/margin_large">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/location_selected_label" android:textColor="@color/text_soft" android:textSize="14sp" />

        <TextView android:id="@+id/tv_selected_delivery_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/location_select_on_map" android:textColor="@color/black" android:textSize="16sp" android:textStyle="bold" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/location_saved_label" android:textColor="@color/text_soft" android:textSize="14sp" />

        <TextView android:id="@+id/tv_saved_address_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/black" android:textSize="15sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center_vertical" android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton android:id="@+id/btn_use_my_location" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:layout_weight="1" android:text="@string/location_use_my_location" app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btn_use_saved_address" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/location_use_saved" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_confirm_delivery_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/location_confirm_delivery" app:cornerRadius="14dp" />

    </LinearLayout>

</LinearLayout>

