<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/white">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="@dimen/margin_large">

        <ImageView android:id="@+id/btn_back_orders_list" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@string/back_button" android:src="@drawable/ic_back" app:tint="@color/black" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/margin_medium" android:text="@string/orders_list_title" android:textColor="@color/black" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_light" />

    <TextView android:id="@+id/tv_orders_loading" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/margin_large" android:text="@string/orders_loading" android:textAlignment="center" android:textColor="@color/text_secondary" android:visibility="gone" />

    <TextView android:id="@+id/tv_orders_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/margin_large" android:text="@string/orders_empty" android:textAlignment="center" android:textColor="@color/text_secondary" android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_orders_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="@dimen/margin_large" />
</LinearLayout>