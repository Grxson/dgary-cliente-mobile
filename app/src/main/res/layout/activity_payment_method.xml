<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/white">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="@dimen/margin_large" android:background="@color/white">

        <ImageView android:id="@+id/btn_back_payment" android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@string/back_button" android:src="@drawable/ic_back" app:tint="@color/black" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/margin_medium" android:text="@string/payment_title" android:textColor="@color/black" android:textSize="20sp" android:textStyle="bold" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_light" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/margin_large">

            <!-- Mis tarjetas -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/payment_my_cards" android:textColor="@color/black" android:textSize="18sp" android:textStyle="bold" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_small" android:layout_marginBottom="@dimen/margin_large" android:text="@string/payment_my_cards_subtitle" android:textColor="@color/text_secondary" android:textSize="14sp" />

            <!-- RecyclerView para tarjetas guardadas -->
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_saved_cards" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_large" android:nestedScrollingEnabled="false" />

            <!-- TextView para cuando no hay tarjetas -->
            <TextView android:id="@+id/tv_no_cards" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_large" android:padding="@dimen/margin_large" android:text="@string/payment_no_cards" android:textAlignment="center" android:textColor="@color/text_secondary" android:textSize="14sp" android:visibility="gone" />

            <!-- Botón Añadir tarjeta -->
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_anadir_tarjeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/margin_large" android:backgroundTint="@color/dgary_green" android:text="@string/payment_add_card_button" android:textColor="@color/white" app:cornerRadius="@dimen/corner_radius_large" app:icon="@drawable/ic_credit_card" app:iconGravity="textStart" />

            <!-- Info de seguridad -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/payment_secure_note" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

